<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Chỉ dùng cho tầng desktop (JavaFX).
  Ánh xạ: Q-01, Q-03, Q-07, Q-15 (không so literal SW trong UI),
  Q-30 (không sleep/blocking trên FX thread), Q-32 (không in APDU thô có PIN).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>
    <property name="severity" value="error"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions-desktop.xml"/>
        <property name="optional" value="true"/>
    </module>

    <module name="FileTabCharacter"/>

    <module name="RegexpSingleline">
        <property name="id" value="desktopNoComments"/>
        <property name="format" value="^\s*(//|\*)"/>
        <property name="message" value="Q-08: không comment trong source; đổi tên method/biến hoặc chuyển lý do sang docs/dev."/>
    </module>

    <module name="RegexpSingleline">
        <property name="id" value="desktopNoBlockComments"/>
        <property name="format" value="/\*"/>
        <property name="message" value="Q-08: không block comment/Javadoc trong source."/>
    </module>

    <module name="FileLength">
        <property name="max" value="1200"/>
    </module>

    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^import |^\s*\*|^\s*//"/>
    </module>

    <!-- Q-30: conservative source check, not thread-flow analysis. -->
    <module name="RegexpSingleline">
        <property name="id" value="desktopThreadSleep"/>
        <property name="format" value="Thread\.sleep\("/>
        <property name="message"
                  value="Q-30: không sleep trên FX thread. Dùng executor nền + Platform.runLater."/>
    </module>

    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <!-- Q-03: đặt tên. -->
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>
        <module name="MemberName"/>
        <module name="ConstantName"/>
        <module name="PackageName"/>

        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NeedBraces"/>
        <module name="ParenPad"/>
        <module name="NoWhitespaceBefore"/>

        <!-- Q-07: không nuốt lỗi. -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="(?!)"/>
            <property name="commentFormat" value="(?!)"/>
        </module>

        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="OneStatementPerLine"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Q-15: không so sánh literal SW. CardGateway hiện sử dụng Sw.OK;
             giữ rule để ngăn tái xuất hiện literal tại nơi khác. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="(==|!=)\s*0x(9000|6982|6983|6985|6700|6A80|6A86|6D00|6E00)\b"/>
            <property name="message"
                      value="Q-15: map SW sang hằng (lớp Sw) thay vì so sánh literal."/>
        </module>

        <!-- Q-32: heuristic only. Cannot prove absence of secret-bearing APDU logging. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="desktopRawApduLogByName"/>
            <property name="format"
                      value="(log|text|append|printf|println)\(.*\b(apdu|command|cmd)Bytes\b"/>
            <property name="message"
                      value="Q-32: kiểm tra luồng dữ liệu APDU trước khi log; không in raw bytes chứa PIN."/>
        </module>

        <!-- Bắt kiểu hex(select.getBytes()) từng bị bỏ sót trong CardGateway.
             Cấm trực tiếp format raw C-APDU, nhưng vẫn phải review helper/alias. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="desktopRawApduHex"/>
            <property name="format"
                      value="(?i)\b(?:hex|formatHex)\s*\(\s*(?:select|command|cmd|apdu|capdu|request)\.getBytes\s*\("/>
            <property name="message"
                      value="Q-32: không format raw C-APDU; chỉ log INS/SW và tham số an toàn."/>
        </module>

    </module>
</module>
