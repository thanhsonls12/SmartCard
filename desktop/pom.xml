<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.labaccess</groupId>
    <artifactId>desktop</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>LabAccess Desktop - Gate 0 smoke UI</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>25</javafx.version>
        <!-- AtlantaFX 2.1.0 duoc build bang Java 21 va JavaFX 23: chay tren JavaFX 25
             vi JavaFX giu tuong thich API ve sau. Khong dung 3.0.0 vi ban do build
             bang JavaFX 27, co the goi API chua co trong 25. -->
        <atlantafx.version>2.1.0</atlantafx.version>
        <ikonli.version>12.4.0</ikonli.version>
        <jackson.version>2.17.2</jackson.version>
        <!-- Chi dung cho kiem thu giao dien: bat che do tu bam nut de chup anh.
             Mac dinh false; chay that thi bo qua. -->
        <labaccess.demo>false</labaccess.demo>
        <!-- Cong simulator; doi duoc khi can test (vi du tro vao mot cong treo). -->
        <labaccess.port>9025</labaccess.port>
        <!-- Chon kich ban demo nao chay khi bat labaccess.demo. -->
        <labaccess.demo.transactions>false</labaccess.demo.transactions>
        <labaccess.demo.history>false</labaccess.demo.history>
        <labaccess.demo.history.ready>false</labaccess.demo.history.ready>
        <labaccess.demo.history.view>false</labaccess.demo.history.view>
        <labaccess.demo.personalize>false</labaccess.demo.personalize>
        <labaccess.demo.photo>false</labaccess.demo.photo>
        <labaccess.demo.enroll>false</labaccess.demo.enroll>
        <labaccess.demo.reconcile>false</labaccess.demo.reconcile>
        <labaccess.demo.reconnect>false</labaccess.demo.reconnect>
        <labaccess.demo.restore>false</labaccess.demo.restore>
        <labaccess.demo.cardId>A1B2C3D41122EF08</labaccess.demo.cardId>
        <labaccess.demo.studentId>SV2024-008</labaccess.demo.studentId>
        <labaccess.backend>http://127.0.0.1:3100</labaccess.backend>
    </properties>

    <dependencies>
        <!-- JavaFX 25: controls keo theo graphics + base tuong ung -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- AtlantaFX: nen theme + control phu. Chi dung atlantafx-base,
             khong keo module decorations/spins de giu dependency gon. -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- Ikonli: icon vector trong JavaFX; pack Feather cho bo icon toi gian. -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-feather-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>

        <!-- Jackson: parse phan hoi Backend theo JSON that, khong doan bang regex.
             Chi dung databind; core va annotations di kem. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- JAR Oracle da cai vao local repo bang install:install-file.
             KHONG phai artifact tren Maven Central. -->
        <dependency>
            <groupId>local.oracle.javacard</groupId>
            <artifactId>socketprovider</artifactId>
            <version>26.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>vn.labaccess.desktop/vn.labaccess.desktop.App</mainClass>
                    <!-- javafx:run fork JVM rieng, nen -D cua Maven khong tu sang.
                         Chuyen tiep tuong minh qua <options>. -->
                    <options>
                        <option>-Dlabaccess.demo=${labaccess.demo}</option>
                        <option>-Dlabaccess.demo.transactions=${labaccess.demo.transactions}</option>
                        <option>-Dlabaccess.demo.history=${labaccess.demo.history}</option>
                        <option>-Dlabaccess.demo.history.ready=${labaccess.demo.history.ready}</option>
                        <option>-Dlabaccess.demo.history.view=${labaccess.demo.history.view}</option>
                        <option>-Dlabaccess.demo.personalize=${labaccess.demo.personalize}</option>
                        <option>-Dlabaccess.demo.photo=${labaccess.demo.photo}</option>
                        <option>-Dlabaccess.demo.enroll=${labaccess.demo.enroll}</option>
                        <option>-Dlabaccess.demo.reconcile=${labaccess.demo.reconcile}</option>
                        <option>-Dlabaccess.demo.reconnect=${labaccess.demo.reconnect}</option>
                        <option>-Dlabaccess.demo.restore=${labaccess.demo.restore}</option>
                        <option>-Dlabaccess.demo.cardId=${labaccess.demo.cardId}</option>
                        <option>-Dlabaccess.demo.studentId=${labaccess.demo.studentId}</option>
                        <option>-Dlabaccess.backend=${labaccess.backend}</option>
                        <option>-Dstdout.encoding=UTF-8</option>
                        <option>-Dstderr.encoding=UTF-8</option>
                        <option>-Dlabaccess.port=${labaccess.port}</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Chạy khi cần: mvn -Pquality checkstyle:check
             Không gắn vào build thường để `javafx:run` không bị chặn bởi lint. -->
        <profile>
            <id>quality</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <configLocation>${project.basedir}/../config/checkstyle/checkstyle-desktop.xml</configLocation>
                            <propertyExpansion>config_loc=${project.basedir}/../config/checkstyle</propertyExpansion>
                            <includeTestSourceDirectory>false</includeTestSourceDirectory>
                            <failOnViolation>true</failOnViolation>
                            <violationSeverity>error</violationSeverity>
                            <consoleOutput>true</consoleOutput>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
