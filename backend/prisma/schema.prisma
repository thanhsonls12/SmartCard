generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id           String   @id @default(uuid()) @db.Uuid
  staffCode    String   @unique @db.VarChar(20)
  username     String   @unique @db.VarChar(64)
  passwordHash String
  displayName  String   @db.VarChar(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  sessions StaffSession[]

  @@map("staff")
}

model StaffSession {
  id         String    @id @default(uuid()) @db.Uuid
  staffId    String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  adminSessions AdminSession[]

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  nonce       Bytes     @db.ByteA
  cardId      Bytes?    @db.ByteA
  activatedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  staffSessionId String? @db.Uuid
  staffSession StaffSession? @relation(fields: [staffSessionId], references: [id], onDelete: Restrict)

  enrollmentChallenges EnrollmentChallenge[]
  profileUpdates       ProfileUpdate[]

  @@index([staffSessionId])
  @@map("admin_sessions")
}

model EnrollmentChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  nonce          Bytes     @db.ByteA
  cardId         Bytes     @db.ByteA
  studentId      String    @db.VarChar(64)
  classCode      String?   @db.VarChar(64)
  publicKey      Bytes     @db.ByteA
  publicKeyHash  Bytes     @db.ByteA
  adminSessionId String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime  @db.Timestamptz(6)
  usedAt         DateTime? @db.Timestamptz(6)

  adminSession AdminSession @relation(fields: [adminSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([nonce])
  @@index([cardId])
  @@index([adminSessionId])
  @@index([expiresAt])
  @@map("enrollment_challenges")
}

enum Operation {
  GRANT
  START
  END
}

model Student {
  id         String   @id @default(uuid()) @db.Uuid
  cardId     Bytes    @unique @db.ByteA
  studentId  String   @db.VarChar(64)
  major      String?  @db.VarChar(64)
  classCode  String?  @db.VarChar(64)
  publicKey  Bytes    @db.ByteA
  enrolledAt DateTime @default(now()) @db.Timestamptz(6)

  ledger         CardLedger?
  transactions   Transaction[]
  profileUpdates ProfileUpdate[]

  @@index([studentId])
  @@map("students")
}

enum ProfileUpdateState {
  PENDING
  COMPLETED
  EXPIRED
  SUPERSEDED
}

model ProfileUpdate {
  id              String              @id @default(uuid()) @db.Uuid
  cardId          Bytes               @db.ByteA
  studentId       String              @db.VarChar(64)
  displayName     String              @db.VarChar(96)
  classCode       String?             @db.VarChar(64)
  expectedVersion Bytes               @db.ByteA
  nonce           Bytes               @db.ByteA
  adminSessionId  String              @db.Uuid
  state           ProfileUpdateState  @default(PENDING)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime            @db.Timestamptz(6)
  completedAt     DateTime?           @db.Timestamptz(6)
  resultMajor     String?             @db.VarChar(64)
  resultStudentId String?             @db.VarChar(64)
  resultClassCode String?             @db.VarChar(64)

  student      Student      @relation(fields: [cardId], references: [cardId], onDelete: Restrict, onUpdate: Cascade)
  adminSession AdminSession @relation(fields: [adminSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([cardId])
  @@index([adminSessionId])
  @@index([expiresAt])
  @@map("profile_updates")
}

model CardLedger {
  cardId        Bytes    @id @db.ByteA
  lastCounter   BigInt   @default(0)
  lastBalance   BigInt   @default(0)
  activeVisitId Bytes?   @db.ByteA
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [cardId], references: [cardId], onDelete: Restrict, onUpdate: Cascade)

  @@map("card_ledgers")
}

model Transaction {
  id           String    @id @default(uuid()) @db.Uuid
  cardId       Bytes     @db.ByteA
  counterAfter BigInt
  operation    Operation
  delta        BigInt
  balanceAfter BigInt
  visitId      Bytes?    @db.ByteA
  payload      Bytes     @db.ByteA
  signature    Bytes     @db.ByteA
  recordedAt   DateTime  @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [cardId], references: [cardId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cardId, counterAfter])
  @@map("transactions")
}
