# Repository text defaults; Windows scripts stay CRLF in the working tree.
* text=auto
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.conf text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve evidence bytes, including hashes and existing log encodings.
artifacts/** -text
logs/** -text
*.cap binary
*.exp binary
*.jca -text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
