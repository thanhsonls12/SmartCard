# LabAccess — quy ước định dạng file, dùng chung cho mọi editor.
# Lý do: tránh diff nhiễu và tránh lỗi CRLF trong script Java Card.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,xml,md,conf}]
indent_size = 4

[*.{ts,tsx,js,mjs,cjs,json,jsonc,yml,yaml}]
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab

# Log và artifact sinh ra tự động: không cần chuẩn hóa.
[*.log]
insert_final_newline = false
trim_trailing_whitespace = false

[*.{cap,exp,jca}]
insert_final_newline = false
